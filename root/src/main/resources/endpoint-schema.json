   },
   "schema":{
      "hostName":{
         "label":"Hostname",
         "signpost": "FQDN or IP address of the PHP IPAM system to be used.",
         "type":{
            "dataType":"string"
         },
         "constraints":{
            "pattern": {
                "value": "^((?=.{1,255}$)([a-zA-Z0-9][-a-zA-Z0-9]*[a-zA-Z0-9]\\.)+[a-zA-Z]{2,}|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$",
                "message": ""
            },
            "required": true
         }
      },
      "port":{
         "label":"Port",
         "step": 1,
         "signpost": "Port that will be used to communicate to target PHP IPAM system.",
         "type":{
            "dataType":"integer"
         },
         "constraints":{
            "pattern": {
                "value": "^([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$",
                "message": ""
            }
         }
      },
      "serviceAccountCheck":{
         "label": "Use Service Account",
            "signpost": "Please consult your security team before using a Service Account.",
            "type": {
               "dataType": "boolean"
            },
            "default": false,
            "constraints": {}
      },
      "serviceAccountUsername":{
         "label":"Service Account Username",
         "signpost": "Service Account Username",
         "type": {
            "dataType": "string"
         },
         "constraints": {
            "required": [
               {
                  "equals": {
                     "serviceAccountCheck": true
                  },
                  "value": true
               },
               {
                  "equals": {
                     "serviceAccountCheck": false
                  },
                  "value": false
               }
            ],
            "min-value": 1
         }
      },
      "serviceAccountPassword":{
         "label": "Service Account Password",
         "signpost": "Password cannot be less than 12 characters long",
         "type": {
            "dataType": "secureString"
         },
         "constraints": {
            "required": [
               {
                  "equals": {
                     "serviceAccountCheck": true
                  },
                  "value": true
               },
               {
                  "equals": {
                     "serviceAccountCheck": false
                  },
                  "value": false
               }
            ],
            "min-value": 12
         }
      },
      "appId":{
         "label": "API Name",
         "type": {
            "dataType": "string"
         },
         "constraints": {
            "min-value": 1,
            "required": true
         }
      },
      "apiKey":{
         "label": "API Token",
         "type": {
            "dataType": "secureString"
         },
         "constraints": {
            "required": [
               {
                  "equals": {
                        "serviceAccountCheck": true
                  },
                  "value": false
               },
               {
                  "equals": {
                        "serviceAccountCheck": false
                  },
                  "value": true
               }
            ]
         }
      },
      "sectionsAccessCheck":{
         "label": "Limit Sections Access",
         "type": {
            "dataType": "boolean"
         },
         "default": false,
         "constraints": {}
      },
      "authorizedSections":{
         "label": "Authorized Sections",
            "signpost": "The PHP IPAM Sections that the integration is authorized to access",
            "type": {
                "dataType": "string",
                "isMultiple": true
            },
            "constraints": {
                "required": [
                    {
                        "equals": {
                            "checkbox_3e00ddbc": true
                        },
                        "value": true
                    },
                    {
                        "equals": {
                            "checkbox_3e00ddbc": false
                        },
                        "value": false
                    }
                ],
                "min-value": 1
            }
      }
   },
   "options":{
      "externalValidations": []
   }
}
