{
   "layout":{
      "pages":[
         {
            "id":"Sample IPAM",
            "title":"Sample IPAM endpoint",
            "sections":[
               {
                  "id":"secion_1",
                  "fields":[
                     {
                        "id":"hostName",
                        "display":"textField",
                        "state": {
                            "visible": true,
                            "read-only": false
                        },
                        "signpostPosition":"right-middle"
                     },
                     {
                        "id":"port",
                        "display":"integerField",
                        "state": {
                            "read-only": false,
                            "visible": [
                                {
                                    "notEmpty": {
                                        "hostName": ""
                                    },
                                    "value": true
                                }
                            ]
                        },
                        "signpostPosition":"right-middle"
                     },
                     {
                        "id":"serviceAccountCheck",
                        "display":"checkbox",
                        "state": {
                            "read-only": false,
                            "visible": [
                                {
                                    "notEmpty": {
                                        "hostName": ""
                                    },
                                    "value": true
                                }
                            ]
                        },
                        "signpostPosition":"right-middle"
                     },
                     {
                        "id":"serviceAccountUsername",
                        "display":"textField",
                        "state": {
                            "read-only": false,
                            "visible": [
                                {
                                    "equals": {
                                        "serviceAccountCheck": false
                                    },
                                    "value": false
                                },
                                {
                                    "equals": {
                                        "serviceAccountCheck": true
                                    },
                                    "value": true
                                }
                            ]
                        },
                        "signpostPosition":"right-middle"
                     },
                     {
                        "id":"serviceAccountPassword",
                        "display":"passwordField",
                        
                        "state": {
                           "read-only": false,
                           "visible": [
                               {
                                   "equals": {
                                       "serviceAccountCheck": false
                                   },
                                   "value": false
                               },
                               {
                                   "equals": {
                                       "serviceAccountCheck": true
                                   },
                                   "value": true
                               }
                           ]
                       },
                        "signpostPosition":"right-middle"
                     },
                     {
                        "id":"appId",
                        "display":"textField",
                        "state": {
                            "read-only": false,
                            "visible": [
                                {
                                    "notEmpty": {
                                        "hostName": ""
                                    },
                                    "value": true
                                },
                                {
                                    "equals": {
                                        "serviceAccountCheck": true
                                    },
                                    "value": true
                                }
                            ]
                        },
                        "signpostPosition": "right-middle"
                     },
                     {
                        "id":"apiKey",
                        "display":"passwordField",
                        "state": {
                            "read-only": false,
                            "visible": [
                                {
                                    "notEmpty": {
                                        "hostName": ""
                                    },
                                    "value": true
                                },
                                {
                                    "equals": {
                                        "serviceAccountCheck": true
